{
  // https://nuxt.com/docs/guide/concepts/typescript
  // Path aliases (`@/*` → frontend root, `#app`, `#components`, …) are generated by Nuxt
  // from `alias` in nuxt.config.ts — do not redeclare `paths` here or they get overridden.
  "extends": "./.nuxt/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true
  }
}
